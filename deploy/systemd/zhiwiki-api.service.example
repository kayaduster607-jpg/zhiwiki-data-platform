[Unit]
Description=ZhiWiki single-host team API
After=network.target
RequiresMountsFor=/var/lib/zhiwiki

[Service]
Type=simple
User=zhiwiki
Group=zhiwiki
WorkingDirectory=/opt/zhiwiki
ExecStart=/opt/zhiwiki/venv/bin/python -B -m zhiwiki.service --config /etc/zhiwiki/team.json serve --port 8872
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhiwiki

[Install]
WantedBy=multi-user.target
